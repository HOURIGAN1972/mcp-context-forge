excludes=/.git/, /.github/,/tests/,/charts/,/docs/,/mcp-servers/, /a2a-agents/,  /infra/, /plugin_templates/,/scripts/,/tools_rust/, /mcpgateway/admin_ui/, /plugins/, /plugins_rust/,/llms/

# Disable Go dependency resolution - Go is not installed in build environment
go.resolveDependencies=false
go.modules.resolveDependencies=false
go.collectDependenciesAtRuntime=false
go.ignoreSourceFiles=true
